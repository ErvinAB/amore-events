# Copy to .env.local and fill in. Never commit real values.

# Public site URL (canonical URLs, Open Graph, sitemap). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provisional brand name until the final name is supplied.
NEXT_PUBLIC_STORE_NAME=Gift Store

# Supabase — Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_…). Safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SERVER ONLY. Secret key (sb_secret_…). Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used only by src/lib/supabase/admin.ts (checkout in V0.2).
SUPABASE_SECRET_KEY=sb_secret_xxx

# SERVER ONLY. Signs checkout form tokens and order confirmations, and hashes
# IPs for throttling. 32+ random characters, different per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHECKOUT_SECRET=

# Owner notification provider. "log" (default) until an email provider is chosen.
ORDER_NOTIFIER=log
